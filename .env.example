APP_ENV=production

# JWT Authentication Configuration
JWT_SECRET=super-secret-key-change-in-prod-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Services URLs
QDRANT_URL=http://qdrant:6333

# Rate Limits (Requests per 60 seconds)
RATE_LIMIT_RAG=10
RATE_LIMIT_AUTH=20

# Logging Level
LOG_LEVEL=INFO

# LLM Config (mock, ollama, openai, gemini)
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_KEY=
LLM_API_BASE=
